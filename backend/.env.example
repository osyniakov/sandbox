# Copy to backend/.env and edit. Kleinanzeigen app-distribution Basic-auth
# values from the official Android client (not personal secrets). Kleinanzeigen
# rotates them; if searches fail with 401/403, put fresh values here.
KLEINANZEIGEN_APP_USER=android
KLEINANZEIGEN_APP_PASSWORD=TaR60pEttY
# App version is OPTIONAL: leave it unset to use the kleinanzeigen-api
# library's own (current) default. Only set it to pin/override that value,
# e.g. if a rotation also requires a specific version string.
#KLEINANZEIGEN_APP_VERSION=
