# Base URL the frontend uses to call the backend API. Copy this file to
# `.env` (or `.env.local`) and adjust if the backend isn't running at the
# default local dev address.
#
# Defaults to http://localhost:8000 in code (see src/App.jsx) if this var
# is unset, so setting it is optional for the standard local dev setup.
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 client ID used to initialize Google Identity Services
# (the "Sign in with Google" button) on the frontend. Must match a client
# ID registered in Google Cloud Console, and should generally match the
# backend's own GOOGLE_CLIENT_ID (see backend/.env.example) since the
# backend verifies ID tokens are issued for this same audience.
VITE_GOOGLE_CLIENT_ID=
