# Base URL the frontend uses to call the backend API. Copy this file to
# `.env` (or `.env.local`) and adjust if the backend isn't running at the
# default local dev address.
#
# Defaults to http://localhost:8000 in code (see src/App.jsx) if this var
# is unset, so setting it is optional for the standard local dev setup.
VITE_API_BASE_URL=http://localhost:8000
