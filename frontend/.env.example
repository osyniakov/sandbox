# The frontend calls the backend same-origin under /api (the backend serves
# the built app in production; `npm run dev` proxies /api to
# http://localhost:8000, override with VITE_DEV_API_PROXY).
# VITE_API_BASE_URL is an optional origin-only override (no /api suffix),
# normally left unset.
# VITE_API_BASE_URL=
# VITE_DEV_API_PROXY=http://localhost:8000

# Google OAuth 2.0 client ID used to initialize Google Identity Services
# (the "Sign in with Google" button) on the frontend. Must match a client
# ID registered in Google Cloud Console, and should generally match the
# backend's own GOOGLE_CLIENT_ID (see backend/.env.example) since the
# backend verifies ID tokens are issued for this same audience.
VITE_GOOGLE_CLIENT_ID=
